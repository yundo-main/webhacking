# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Supabase Postgres (Project → Connect).
# On Vercel with the Supabase integration, POSTGRES_URL / POSTGRES_URL_NON_POOLING are set for you
# and these two can stay empty.
#   DATABASE_URL: Transaction pooler, port 6543 (runtime, serverless-friendly)
#   DIRECT_URL  : Session pooler (port 5432) or direct connection (migrations: npm run db:migrate)
DATABASE_URL=
DIRECT_URL=

# Portal origin. Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-player flag key (32+ chars). Changing it invalidates every flag already handed out.
FLAG_SECRET=

# Challenge site: same deployment, separate origin. Local: http://lab.localhost:3000
# Production: a domain on a different registrable domain from the portal (e.g. https://lab.example-labs.net)
LAB_ORIGIN=http://lab.localhost:3000
# Signs launch/player/session tokens on the challenge site (32+ chars, different from the others)
LAB_SECRET=

# Optional competition window (ISO 8601). Leave empty to keep submissions always open.
CTF_START=
CTF_END=

# Set to true to close new email/password sign-ups (existing accounts can still sign in).
EMAIL_SIGNUP_DISABLED=
